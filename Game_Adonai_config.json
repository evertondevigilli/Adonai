                        "toBottom",
                        "shuffle",
                        "draw"
                    ],
                    "selectionRange": {
                        "min": 0,
                        "max": 6
                    },
                    "keepCardsOrder": true
                }
            },
            "newTurn": {
                "drawOnStart": false,
                "drawPerTurn": 2
            },
            "steps": [
                { "id": "preparacao", "name": "Preparação" },

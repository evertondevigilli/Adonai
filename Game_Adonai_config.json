        "Standard": {
            "mulligan": {
                "triggeredByButton": true,
                "startingHandSize": 6,
                "mulliganCount": {
                    "min": 0,
                    "max": 3
                },
                "mulliganCycle": {
                    "info": "Você pode escolher qualquer número de cartas da mão inicial, devolvê-las ao baralho e comprar novas cartas, até 3 vezes.",

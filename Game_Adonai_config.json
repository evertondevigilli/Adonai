        "deckRulesets": {
            "Adonai40Singleton": {
                "general": {
                    "min": 47,
                    "max": 57,
                    "maxPerCard": 1
                },
                "categories": [
                    { "category": "Campeão", "min": 1, "max": 1 },
                    { "category": "Templo", "min": 1, "max": 1 },
